# SYmuS credentials for playlist import.
#
# Copy this file to `.env` in the same folder and fill in the values you need.
# An installed build reads `.env` from its user-data folder instead:
#   Windows  %APPDATA%\symus-desktop\.env
#   macOS    ~/Library/Application Support/symus-desktop/.env
#   Linux    ~/.config/symus-desktop/.env
#
# Nothing here is required to run SYmuS. YouTube search, playback and YouTube
# playlist import all work with no credentials at all. These keys only enable
# importing playlists from Spotify and Apple Music, and only ever fetch track
# metadata — titles, artists, album names and running order. No audio is ever
# requested from those services; every track is played from YouTube.

# Spotify — https://developer.spotify.com/dashboard
# Create an app; the client ID and secret are on its settings page. No redirect
# URI or user login is needed, because import uses the client-credentials flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music — https://developer.apple.com/account/resources/authkeys/list
# Requires a paid Apple Developer account. Create a MusicKit key, then sign a
# JWT with it; that signed token goes here. Apple caps these at six months, so
# this one needs replacing periodically.
APPLE_MUSIC_DEVELOPER_TOKEN=
